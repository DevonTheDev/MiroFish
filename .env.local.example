# Copy this file to .env. No cloud keys are needed in local mode.
MEMORY_BACKEND=local
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL_NAME=mirofish-local
LOCAL_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_EMBEDDING_MODEL=nomic-embed-text
LOCAL_EMBEDDING_DIMENSIONS=768
LOCAL_GRAPH_URI=bolt://127.0.0.1:7687
LOCAL_GRAPH_DATABASE=neo4j
LOCAL_GRAPH_USER=neo4j
LOCAL_GRAPH_PASSWORD=
# One shared budget for web app, memory, and all simulation subprocesses.
LOCAL_MAX_CONCURRENCY=1
LOCAL_MAX_QUEUE=32
LOCAL_REQUEST_TIMEOUT=180
LOCAL_CONTEXT_TOKENS=8192
LOCAL_MAX_OUTPUT_TOKENS=2048
LOCAL_MAX_INPUT_CHARS=24000
# Ollama: disable thinking for compact structured outputs. Empty omits the field.
LOCAL_REASONING_EFFORT=none
FLASK_DEBUG=false
# Also set these in the environment of the separately running Ollama server.
OLLAMA_NO_CLOUD=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
# Explicit safety caps; larger graphs fail with a clear message instead of dropping agents.
LOCAL_MAX_AGENTS=10
LOCAL_MAX_ROUNDS=5
LOCAL_MAX_AGENT_ITERATIONS=3
